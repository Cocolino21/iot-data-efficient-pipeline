 plantuml
  @startuml

  
  skinparam componentStyle rectangle
  skinparam shadowing false

  [router.js] as Router
  [layouts/AppLayout.vue] as AppLayout

  package "Pages" {
    [LoginPage.vue] as Login
    [DevicesPage.vue] as Devices
    [DeviceDetailPage.vue] as DeviceDetail
    [DashboardPage.vue] as Dashboard
    [ExplorePage.vue] as Explore
  }

  package "Panels" {
    [PanelRenderer.vue] as Renderer
    [LinePanel / BarPanel / GaugePanel\nStatPanel / TablePanel] as PanelSet
  }

  [services/api.js] as Api


  Router --> AppLayout
  AppLayout --> Login
  AppLayout --> Devices
  AppLayout --> DeviceDetail
  AppLayout --> Dashboard
  AppLayout --> Explore

  Dashboard --> Renderer
  Explore --> Renderer
  DeviceDetail --> Renderer
  Renderer --> PanelSet

  Login --> Api
  Devices --> Api
  DeviceDetail --> Api
  PanelSet --> Api

  Api --> Backend
  @enduml